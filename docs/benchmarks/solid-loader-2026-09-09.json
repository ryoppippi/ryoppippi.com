	"verification": "One experimental build generated428 outputs; no browser/hydration check or timing comparison for this variant. Original Solid config and dist restored after collection.",
	"plugin": "import type { Plugin } from 'vite-plus';\nexport function benchmarkRuntimeImports(): Plugin {\n  const prefix = 'virtual:benchmark-solid-';\n  let replacements = 0;\n  return {\n    name: 'benchmark-narrow-solid-runtime-imports',\n    enforce: 'pre',\n    resolveId(id) { if (id.startsWith(prefix)) return '\\0' + id; },\n    load(id) {\n      if (id === '\\0' + prefix + 'web') return 'export { render, hydrate } from \"@solidjs/web\";';\n      if (id === '\\0' + prefix + 'core') return 'export { createComponent } from \"solid-js\";';\n    },\n    transform(code, id) {\n      if (!id.includes('vite-plugin-solid') || !id.endsWith('/html-host-client2.mjs')) return;\n      const from = 'Promise.all([import(\"@solidjs/web\"), import(\"solid-js\")])';\n      if (!code.includes(from)) throw new Error('Expected original loader');\n      replacements++;\n      return code.replace(from, 'Promise.all([import(\"virtual:benchmark-solid-web\"), import(\"virtual:benchmark-solid-core\")])');\n    },\n    closeBundle() { console.log('[benchmark] loader replacements: ' + replacements); },\n  };\n}\n",
