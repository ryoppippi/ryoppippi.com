{
	"name": "ryoppippi.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run site-build",
		"check": "vp check",
		"deploy": "wrangler deploy",
		"deploy:non-production": "wrangler versions upload",
		"dev": "vp dev",
		"format": "vp check --fix",
		"preinstall": "only-allow pnpm",
		"prepare": "vp config --no-agent",
		"lint": "vp lint",
		"new": "bun scripts/new-post.ts",
		"preview": "vp preview",
		"test": "vp test --run --project=node --project=browser",
		"test:browser": "vp test --project browser",
		"test:browser:run": "vp test --run --project browser",
		"typos": "typos --force-exclude src/contents src/content/blog src/content/showcase",
		"update:oss-stars": "./.github/update-oss-stars.nu"
	},
