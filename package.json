{
	"name": "ryoppippi.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run site-build",
		"check": "vp run static-check",
		"check:svelte": "vp run svelte-check",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:non-production": "wrangler versions upload",
		"dev": "vp dev",
		"format": "vp check --fix",
		"preinstall": "only-allow pnpm",
		"prepare": "vp config --no-agent",
		"lint": "vp lint",
		"new": "node scripts/new-post.ts",
		"preview": "vp preview",
		"test": "vp test --run",
		"typos": "typos --force-exclude",
		"update:oss-stars": "./.github/update-oss-stars.nu",
		"validate:content": "oxct validate"
	},
	"devDependencies": {
		"@clack/prompts": "catalog:",
		"@fontsource/dm-mono": "catalog:",
		"@fontsource/inter": "catalog:",
		"@fontsource/jetbrains-mono": "catalog:",
		"@fontsource/roboto-condensed": "catalog:",
		"@iconify/json": "catalog:",
		"@ox-content/islands": "catalog:",
		"@ox-content/napi": "catalog:",
		"@ox-content/theme-color-kanagawa": "catalog:",
		"@ox-content/vite-plugin": "catalog:",
		"@ox-content/vite-plugin-svelte": "catalog:",
		"@rsvelte/vite-plugin-svelte": "catalog:",
		"@tanstack/charts": "catalog:",
		"@types/d3-scale": "catalog:",
		"@types/d3-shape": "catalog:",
		"@types/fs-extra": "catalog:",
		"@types/node": "catalog:",
		"budoux": "catalog:",
		"d3-scale": "catalog:",
		"d3-shape": "catalog:",
		"fs-extra": "catalog:",
		"fs-fixture": "catalog:",
		"msw": "catalog:",
		"only-allow": "catalog:",
		"open-editor": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tinyglobby": "catalog:",
		"typescript": "catalog:",
		"ufo": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": "^24.14.0",
				"onFail": "download"
			}
		]
	},
	"packageManager": "pnpm@12.4.1"
}
