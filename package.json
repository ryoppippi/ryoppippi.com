{
	"name": "ryoppippi.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run site-build",
		"check": "vp check",
		"deploy": "wrangler deploy",
		"deploy:non-production": "wrangler versions upload",
		"dev": "vp dev",
		"format": "vp check --fix",
		"preinstall": "only-allow pnpm",
		"prepare": "vp config --no-agent",
		"lint": "vp lint",
		"new": "vp run @ryoppippi/content#new",
		"preview": "vp preview",
		"test": "vp test --run",
		"typos": "typos --force-exclude src/contents packages/content/src/blog packages/content/src/showcase",
		"update:oss-stars": "./.github/update-oss-stars.nu"
	},
	"devDependencies": {
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/roboto-condensed": "^5.3.0",
		"@iconify/json": "^2.2.510",
		"@iconify/tailwind4": "^1.2.3",
		"@ox-content/napi": "catalog:",
		"@ox-content/vite-plugin": "3.0.0-alpha.11",
		"@ox-content/vite-plugin-svelte": "3.0.0-alpha.11",
		"@ryoppippi/content": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.13.3",
		"budoux": "^0.9.0",
		"bun": "1.3.14",
		"fontaine": "^0.8.0",
		"fs-fixture": "^2.14.0",
		"only-allow": "^1.2.2",
		"parse5": "^7.3.0",
		"rss-parser": "^3.13.0",
		"solid-js": "^1.9.15",
		"svelte": "^5.56.10",
		"tailwindcss": "^4.3.3",
		"tinyglobby": "^0.2.17",
		"ufo": "^1.6.4",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
		"vite-plugin-solid": "^2.11.14",
		"vite-plus": "0.2.9",
		"vitest": "4.1.10"
	},
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": "^24.14.0",
				"onFail": "download"
			}
		]
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
