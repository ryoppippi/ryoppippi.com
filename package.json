{
	"name": "ryoppippi.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run site-build",
		"check": "vp check && pnpm run check:svelte",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json && prettier --check \"src/**/*.svelte\"",
		"deploy": "wrangler deploy",
		"deploy:non-production": "wrangler versions upload",
		"dev": "vp dev",
		"format": "vp check --fix && prettier --write \"src/**/*.svelte\"",
		"preinstall": "only-allow pnpm",
		"prepare": "vp config --no-agent",
		"lint": "vp lint",
		"new": "bun scripts/new-post.ts",
		"preview": "vp preview",
		"test": "vp test --run",
		"typos": "typos --force-exclude",
		"update:oss-stars": "./.github/update-oss-stars.nu"
	},
	"devDependencies": {
		"@clack/prompts": "catalog:",
		"@fontsource/dm-mono": "catalog:",
		"@fontsource/inter": "catalog:",
		"@fontsource/jetbrains-mono": "catalog:",
		"@fontsource/roboto-condensed": "catalog:",
		"@iconify/json": "catalog:",
		"@ox-content/islands": "catalog:",
		"@ox-content/theme-color-kanagawa": "catalog:",
		"@ox-content/vite-plugin": "catalog:",
		"@ox-content/vite-plugin-solid": "catalog:",
		"@ox-content/vite-plugin-svelte": "catalog:",
		"@rsvelte/vite-plugin-svelte": "catalog:",
		"@solidjs/vite-plugin": "catalog:",
		"@solidjs/web": "catalog:",
		"@tanstack/charts": "catalog:",
		"@types/bun": "catalog:",
		"@types/d3-scale": "catalog:",
		"@types/d3-shape": "catalog:",
		"@types/fs-extra": "catalog:",
		"@types/node": "catalog:",
		"budoux": "catalog:",
		"bun": "catalog:",
		"d3-scale": "catalog:",
		"d3-shape": "catalog:",
		"date-fns": "catalog:",
		"fs-extra": "catalog:",
		"fs-fixture": "catalog:",
		"gray-matter-es": "catalog:",
		"msw": "catalog:",
		"only-allow": "catalog:",
		"open-editor": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"solid-js": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tinyglobby": "catalog:",
		"typescript": "catalog:",
		"ufo": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": "^24.14.0",
				"onFail": "download"
			}
		]
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
